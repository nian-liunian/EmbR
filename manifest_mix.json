      "scf_frames": [
        1
      ]
    },
    {
      "mode": "ab_initio",
      "prefix": "Lys+",
      "out_dir": "data/train/Lys+",
      "QM_atoms": 25,
      "qm_charge": 1,
      "i0": 1,
      "n_frames": 600,
      "e0_file": "ELys+.txt",
      "scf_frames": [
        1
      ]
